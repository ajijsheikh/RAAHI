# RAAHI Environment Configuration
# Critical: Never commit .env to version control — it contains secrets

# Database (Postgres with PostGIS) - matches infra/docker-compose.yml credentials
DATABASE_URL=postgresql+asyncpg://raahi:raahi@localhost:5432/raahi

# LLM Providers (at least one required)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# App Settings
LLM_TIMEOUT_S=8
AUTH_MODE=header          # "header" or "supabase_jwt"
SAFETY_SCORE_FLOOR=0.35

# Supabase (required if AUTH_MODE=supabase_jwt)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Twilio (required for safety SOS alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Override number for demo — sends to this number regardless of user input
TWILIO_TO_NUMBER_OVERRIDE=

# Monitoring
ALERTS_ENABLED=true
DELAY_THRESHOLD_MIN=15
MONITOR_POLL_INTERVAL_S=5
GEOFENCE_BUFFER_M=50

# IRCTC (travel claim verification - RapidAPI-style provider)
# Without these, /irctc endpoints return simulated data marked source=simulated
IRCTC_ENABLED=false
IRCTC_API_KEY=
IRCTC_API_HOST=